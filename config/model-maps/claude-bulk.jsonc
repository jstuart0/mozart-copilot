// Shipped preset: claude-bulk. Build-time source only, repo root, never
// installed (D14) — copy this file over .github/mozart/config/model-map.jsonc
// with `apply_models.py --preset claude-bulk --apply`, which also stamps
// every agent's `model:` frontmatter to match.
//
// All Anthropic except validation, which is always the non-builder family
// (D8): sebastian runs GPT-5.4 under this preset so the counterpoint review
// is a genuine cross-model read, not a same-family echo.
{
  "roles": {
    "conductor": {
      "model": "claude-opus-4.5",
      "family": "anthropic",
      "fallback": "claude-opus-4.1"
    },
    "deep-reviewers": {
      "model": "claude-opus-4.5",
      "family": "anthropic",
      "fallback": "claude-opus-4.1"
    },
    "builders": {
      "model": "claude-sonnet-4.5",
      "family": "anthropic",
      "fallback": "claude-sonnet-4.1"
    },
    "reviewers": {
      "model": "claude-sonnet-4.5",
      "family": "anthropic",
      "fallback": "claude-sonnet-4.1"
    },
    "support": {
      "model": "claude-sonnet-4.5",
      "family": "anthropic",
      "fallback": "claude-sonnet-4.1"
    },
    "fast-scan": {
      "model": "claude-haiku-4.5",
      "family": "anthropic",
      "fallback": "claude-haiku-4.1"
    },
    "validation": {
      "model": "gpt-5.4",
      "family": "openai",
      "fallback": "gpt-5.1"
    }
  },
  "agents": {
    "mozart": "conductor",

    "harry": "deep-reviewers",
    "bob": "deep-reviewers",
    "ruby": "deep-reviewers",
    "valerie": "deep-reviewers",

    "jackson": "builders",
    "hank": "builders",
    "scott": "builders",

    "dexter": "reviewers",
    "xander": "reviewers",
    "otto": "reviewers",
    "ian": "reviewers",
    "tessa": "reviewers",
    "percy": "reviewers",
    "librarian": "reviewers",
    "dick": "reviewers",
    "sarah": "reviewers",

    "codebase-analyzer": "support",
    "codebase-pattern-finder": "support",
    "web-search-researcher": "support",

    "codebase-locator": "fast-scan",

    "sebastian": "validation"
  }
}
