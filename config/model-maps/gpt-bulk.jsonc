// Shipped preset: gpt-bulk. Build-time source only, repo root, never
// installed (D14) — copy this file over .github/mozart/config/model-map.jsonc
// with `apply_models.py --preset gpt-bulk --apply`, which also stamps every
// agent's `model:` frontmatter to match.
//
// All OpenAI except validation, which is always the non-builder family
// (D8): under this preset sebastian runs Claude Opus 5, so the
// counterpoint review stays a genuine cross-model read even when the bulk
// of the roster flips family.
{
  "roles": {
    "conductor": {
      "model": "gpt-5.6-sol",
      "family": "openai",
      "fallback": "gpt-5.6-terra"
    },
    "deep-reviewers": {
      "model": "gpt-5.6-sol",
      "family": "openai",
      "fallback": "gpt-5.6-terra"
    },
    "builders": {
      "model": "gpt-5.3-codex",
      "family": "openai",
      "fallback": "gpt-5.6-sol"
    },
    "reviewers": {
      "model": "gpt-5.3-codex",
      "family": "openai",
      "fallback": "gpt-5.6-sol"
    },
    "support": {
      "model": "gpt-5.3-codex",
      "family": "openai",
      "fallback": "gpt-5.6-sol"
    },
    "fast-scan": {
      "model": "gpt-5.6-luna",
      "family": "openai",
      "fallback": "gpt-5.6-terra"
    },
    "validation": {
      "model": "claude-opus-5",
      "family": "anthropic",
      "fallback": "claude-sonnet-5"
    }
  },
  "agents": {
    "mozart": "conductor",

    "harry": "deep-reviewers",
    "bob": "deep-reviewers",
    "ruby": "deep-reviewers",
    "valerie": "deep-reviewers",

    "jackson": "builders",
    "hank": "builders",
    "scott": "builders",

    "dexter": "reviewers",
    "xander": "reviewers",
    "otto": "reviewers",
    "nina": "reviewers",
    "ian": "reviewers",
    "tessa": "reviewers",
    "percy": "reviewers",
    "librarian": "reviewers",
    "dick": "reviewers",
    "sarah": "reviewers",

    "codebase-analyzer": "support",
    "codebase-pattern-finder": "support",
    "web-search-researcher": "support",

    "codebase-locator": "fast-scan",

    "sebastian": "validation"
  }
}
