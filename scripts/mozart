#!/usr/bin/env bash
# scripts/mozart — the CLI wrapper (D6/D9/D10/D12).
#
# Carries the grants a bare `copilot` launch doesn't have: the user-scope
# bundle root(s) via --add-dir, and — inside a git repo — working-directory
# normalization to the repo root (D9), so mozart's repo-root-relative state
# model (.mozart/plans/...) and the agent's relative bundle probe both
# resolve against the repo, not wherever the shell happened to be. Defines
# zero flags of its own (D6): every argument passes through to `copilot`
# verbatim after the fixed grants. `COPILOT_HOME` is the only configuration
# input.
set -euo pipefail

HOME_DIR="${COPILOT_HOME:-$HOME/.copilot}"
BUNDLE="$HOME_DIR/mozart"
DEFAULT="$HOME/.copilot/mozart"

if ! command -v copilot >/dev/null 2>&1; then
  echo "mozart: 'copilot' is not on your \$PATH — install the Copilot CLI first." >&2
  exit 127
fi

# "Not installed" is reported before "not linked" (r3, bob R2): with a
# custom COPILOT_HOME and nothing installed, checking the symlink contract
# first would hand the user an `ln -s` that creates a dangling link to a
# bundle that doesn't exist. Installing is the prerequisite.
if [ ! -f "$BUNDLE/VERSION" ]; then
  echo "mozart: no bundle found at $BUNDLE — run 'install-bundle.sh --user-scope --apply' first." >&2
  exit 1
fi

ADD_DIRS=(--add-dir "$BUNDLE")

# Custom-home contract (D10), only when the resolved home differs from the
# default — agents probe $DEFAULT only, so without this a custom-home
# launch either always halts on a missing bundle, or — worse — silently
# reads a stale one left over from an earlier default-path install.
if [ "$BUNDLE" != "$DEFAULT" ]; then
  if [ -L "$DEFAULT" ]; then
    # Compare by physical resolution, not the raw symlink target text —
    # the CLI's own path check may compare paths rather than inodes, but
    # our *contract* check must not be fooled by a differently-spelled
    # equivalent path (relative target, extra '..', etc).
    default_resolved="$(cd "$DEFAULT" 2>/dev/null && pwd -P || true)"
    bundle_resolved="$(cd "$BUNDLE" 2>/dev/null && pwd -P || true)"
    if [ -n "$default_resolved" ] && [ "$default_resolved" = "$bundle_resolved" ]; then
      # Grant both spellings — the CLI's own path check may compare paths
      # rather than inodes, so the literal $DEFAULT path must be named too.
      ADD_DIRS+=(--add-dir "$DEFAULT")
    else
      echo "mozart: $DEFAULT is a symlink to a stale bundle (not $BUNDLE) — it would shadow the configured one." >&2
      echo "  remove it and re-link: rm \"$DEFAULT\" && ln -s \"$BUNDLE\" \"$DEFAULT\"" >&2
      echo "  or unset COPILOT_HOME to use the default bundle instead." >&2
      exit 1
    fi
  elif [ -e "$DEFAULT" ]; then
    echo "mozart: $DEFAULT already exists as a real directory — a stale bundle that would shadow the configured one ($BUNDLE)." >&2
    echo "  remove it and re-link: rm -rf \"$DEFAULT\" && ln -s \"$BUNDLE\" \"$DEFAULT\"" >&2
    echo "  or unset COPILOT_HOME to use the default bundle instead." >&2
    exit 1
  else
    echo "mozart: COPILOT_HOME names a custom home, but $DEFAULT does not exist. Agents probe the default path only — link it:" >&2
    echo "  mkdir -p \"$(dirname "$DEFAULT")\" && ln -s \"$BUNDLE\" \"$DEFAULT\"" >&2
    exit 1
  fi
fi

# D9: repo-root normalization, compared by physical resolution — git
# resolves symlinked ancestors (e.g. macOS /tmp -> /private/tmp) in
# --show-toplevel's output, and $PWD does not, so a raw string compare
# would announce and `cd` even when already sitting at the repo root.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$ROOT" ] && [ "$ROOT" != "$(pwd -P)" ]; then
  echo "mozart: running from repo root $ROOT (launched in $PWD)" >&2
  cd "$ROOT"
fi

# --------------------------------------------------------------------------
# Provenance gate (P17, D-E/D-H). The LAST check before exec. When the repo
# this launch is rooted in ships its own bundle (.github/mozart), compare it
# against the installed bundle; on ANY difference, REFUSE unless the repo root
# is trusted — recorded at install time (P16), or named for THIS invocation by
# the MOZART_TRUST_REPO_BUNDLE override. Everything else fails closed, exit 1.
#
# Consent + baseline comparison, NOT authenticity (P18): it proves "this tree
# is not the one you installed from", never "this tree is genuine". Never runs
# when there is no repo-local bundle. Prints nothing on the trusted or
# byte-identical paths. The pre-existing exits above (127 no copilot, 1 no
# bundle, 1 custom-home contract) are all upstream of here and unchanged.
# --------------------------------------------------------------------------

# dev_ino DIR — canonical identity of a directory as "device:inode", or empty
# on failure. COPIED VERBATIM from scripts/install-bundle.sh (D-H mandates ONE
# identity routine across the recorded root, the current root and the override;
# the script is the canonical source, this is the copy). GNU-FIRST (`stat -c`),
# BSD-SECOND (`stat -f`): on GNU coreutils `stat -f` is --file-system and
# '%d:%i' are VALID there, returning per-VOLUME stats identical for every path
# on one filesystem — a BSD-first order would make the gate trust any two
# co-located directories, failing OPEN on every Linux host and CI runner. BSD
# `stat` rejects `-c` outright, so GNU-first falls through correctly there.
# Empty output on EITHER side of a comparison is a NON-match (asserted below).
dev_ino() { stat -c '%d:%i' "$1" 2>/dev/null || stat -f '%d:%i' "$1" 2>/dev/null; }

GATE_ROOT="$(pwd -P)" || GATE_ROOT=""
if [ -z "$GATE_ROOT" ]; then
  # sebastian MEDIUM-1: the last unguarded `$(pwd -P)` under set -euo pipefail.
  # If the physical cwd cannot be resolved (e.g. it was deleted underneath us),
  # a bare assignment would exit here — BEFORE the provenance refusal banner —
  # with a nondeterministic status and no explanation. Fail closed loudly
  # instead: refuse to launch rather than evaluate provenance against an
  # unknown root.
  echo "mozart: REFUSED — cannot resolve the physical working directory (pwd -P failed); refusing to launch rather than evaluate bundle provenance against an unknown root." >&2
  exit 1
fi
REPO_BUNDLE="$GATE_ROOT/.github/mozart"

if [ -f "$REPO_BUNDLE/VERSION" ] && ! diff -r -q "$REPO_BUNDLE" "$BUNDLE" >/dev/null 2>&1; then
  # The repo ships a bundle that differs from the installed one. Exempt only a
  # trusted root; otherwise refuse. (diff exit 2 on error also lands here —
  # fail closed.)
  gate_root_id="$(dev_ino "$GATE_ROOT")" || gate_root_id=""
  trusted=0

  # 1. Per-invocation override (root-scoped, never a global boolean): the value
  #    must name THIS repo root, by exact physical path or by dev_ino identity.
  override="${MOZART_TRUST_REPO_BUNDLE:-}"
  if [ -n "$override" ]; then
    # `|| var=""` keeps a failed resolution (nonexistent path -> nonzero) from
    # tripping `set -e`; the empty value then fails closed below.
    override_canon="$(cd "$override" 2>/dev/null && pwd -P)" || override_canon=""
    override_id="$(dev_ino "$override")" || override_id=""
    if [ -n "$override_canon" ] && [ "$override_canon" = "$GATE_ROOT" ]; then
      trusted=1
    elif [ -n "$gate_root_id" ] && [ -n "$override_id" ] && [ "$override_id" = "$gate_root_id" ]; then
      # Both dev_ino sides EXPLICITLY non-empty AND equal. An empty dev_ino on
      # EITHER side is a NON-match — fail closed, never inherited implicitly.
      trusted=1
    fi
  fi

  # 2. Recorded trust roots (user-side state; an absent/unreadable file means
  #    NO roots — fail closed, never an error that blocks the launch for an
  #    unrelated reason).
  if [ "$trusted" -eq 0 ]; then
    rootsfile="$HOME_DIR/mozart-trust/roots"
    if [ -f "$rootsfile" ] && [ -r "$rootsfile" ]; then
      while IFS= read -r rec || [ -n "$rec" ]; do
        [ -z "$rec" ] && continue
        if [ "$rec" = "$GATE_ROOT" ]; then trusted=1; break; fi
        # `|| rec_id=""`: a stale/nonexistent recorded root (dev_ino nonzero)
        # must be a NON-match, NOT a `set -e` exit that would refuse a
        # legitimately-trusted root recorded on a LATER line.
        rec_id="$(dev_ino "$rec")" || rec_id=""
        if [ -n "$gate_root_id" ] && [ -n "$rec_id" ] && [ "$rec_id" = "$gate_root_id" ]; then
          # Empty dev_ino on EITHER side is an explicit NON-match (fail closed).
          trusted=1; break
        fi
      done < "$rootsfile"
    fi
  fi

  if [ "$trusted" -eq 0 ]; then
    echo "mozart: REFUSED — bundle provenance mismatch." >&2
    echo "  the bundle shipped by this repo differs from the one you installed:" >&2
    echo "    repo-local bundle : $REPO_BUNDLE" >&2
    echo "    installed bundle  : $BUNDLE" >&2
    echo "    repo root         : $GATE_ROOT" >&2
    echo "  this proves the tree is not the one you installed from — it does NOT prove the tree is malicious, and it does NOT prove it is genuine (consent + baseline comparison, not authenticity)." >&2
    echo "  if you trust this repo, either reinstall from it to record it as a trusted root:" >&2
    echo "    scripts/install-bundle.sh --user-scope --apply   (run from $GATE_ROOT)" >&2
    echo "  or trust it for THIS invocation only (root-scoped, never a global boolean; do NOT auto-load it via direnv/.envrc):" >&2
    echo "    MOZART_TRUST_REPO_BUNDLE=\"$GATE_ROOT\" mozart \"<task>\"" >&2
    exit 1
  fi
fi

exec copilot --agent mozart "${ADD_DIRS[@]}" "$@"
