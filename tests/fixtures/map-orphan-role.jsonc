// Negative fixture for check_agents.py --map / apply_models.py --validate-map.
// Regenerated in P9 (D-G): a full, otherwise-valid 22-agent map (the canonical
// claude-bulk roster) with EXACTLY ONE injected defect — the role
// "isolated-role" is defined but assigned to no agent. Run against the real
// .github/agents/ roster this produces exactly one FAIL (the orphan role) and
// nothing else, so the fixture proves the orphan-role check specifically rather
// than drowning it in ~20 unrelated coverage errors (the pre-P9 stale form had
// a 2-agent roster and exited 1 for the wrong reason).
{
  "roles": {
    "conductor": { "model": "claude-opus-5", "family": "anthropic", "fallback": "claude-sonnet-5" },
    "deep-reviewers": { "model": "claude-opus-5", "family": "anthropic", "fallback": "claude-sonnet-5" },
    "builders": { "model": "claude-sonnet-5", "family": "anthropic", "fallback": "claude-opus-4.8" },
    "reviewers": { "model": "claude-sonnet-5", "family": "anthropic", "fallback": "claude-opus-4.8" },
    "support": { "model": "claude-sonnet-5", "family": "anthropic", "fallback": "claude-opus-4.8" },
    "fast-scan": { "model": "claude-haiku-4.5", "family": "anthropic", "fallback": "claude-sonnet-5" },
    "validation": { "model": "gpt-5.6-sol", "family": "openai", "fallback": "gpt-5.6-terra" },
    "isolated-role": { "model": "claude-sonnet-5", "family": "anthropic", "fallback": "claude-opus-4.8" }
  },
